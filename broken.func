    pub fn recover(&mut self)->Result<(),DbError>{
        let mut entry=self.wal.get_log_any(None)?;

        while let Some((log,data,iterator))=entry{
            let record_id=log.record_id;
            let page_id=log.page_id;

            {
                let page=self.pool.get_page_mut(page_id)?;

                if page.header.lsn>=log.lsn{
                    entry=self.wal.get_log_any(Some(iterator))?;
                    continue;
                }
            }

            match log.task_type{
                TaskType::Delete=>{
                    {
                        let page=self.pool.get_page_mut(page_id)?;

                        match page.delete_record(record_id){
                            Ok(_)=>{},

                            Err(DbError::RecordAbsent)=>{},

                            Err(e)=>return Err(e),
                        };
                    }

                    match self.tree.search(record_id){
                        Ok(_)=>{
                            self.tree.delete(record_id)?;
                        },

                        Err(DbError::RecordAbsent)=>{},

                        Err(e)=>return Err(e),
                    }
                },

                TaskType::Write=>{
                    let buf=match data{
                        Some(v)=>v,
                        None=>return Err(DbError::CorruptedWAL),
                    };

                    {
                        let page=self.pool.get_page_mut(page_id)?;

                        match page.write_record(
                            record_id,
                            &buf,
                            log.log_size as usize-24
                        ){
                            Ok(_)=>{},

                            Err(DbError::SpaceOver)=>{
                                return Err(DbError::SpaceOver);
                            },

                            Err(e)=>return Err(e),
                        };
                    }

                    match self.tree.search(record_id){
                        Ok(old_page_id)=>{
                            if old_page_id!=page_id{
                                self.tree.delete(record_id)?;
                                self.tree.insert(record_id,page_id)?;
                            }
                        },

                        Err(DbError::RecordAbsent)=>{
                            self.tree.insert(record_id,page_id)?;
                        },

                        Err(e)=>return Err(e),
                    }
                },

                TaskType::Update=>{
                    let buf=match data{
                        Some(v)=>v,
                        None=>return Err(DbError::CorruptedWAL),
                    };

                    let moved=match self.pool.get_page_mut(page_id)?.update_record(
                        record_id,
                        &buf,
                        log.log_size as usize-24
                    ){
                        Ok(_)=>false,

                        Err(DbError::SpaceOver)=>true,

                        Err(e)=>return Err(e),
                    };

                    if moved{
                        /*
                        The old page could not hold the updated record.

                        update_record() has already performed its internal
                        deletion of the old record.

                        The subsequent WRITE WAL entry is responsible for
                        placing the record on its new page and updating the
                        B+ tree.
                        */
                    }
                },
            }

            {
                let page=self.pool.get_page_mut(page_id)?;
                page.header.lsn=log.lsn;
            }

            entry=self.wal.get_log_any(Some(iterator))?;
        }

        self.pool.flush_all()?;
        self.tree.serialise(&mut self.pool.db_file)?;
        self.wal.reset()?;

        self.next_record_id=
            self.tree.max_key().map(|k|k+1).unwrap_or(1);

        Ok(())
    }

